    {
      "datasource": {
        "type": "prometheus"
      },
      "description": "Overall GPU health status\n- 0: normal\n- 1+: number of GPUs that are unhealthy",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 11,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "percentChangeColorMode": "standard",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "text": {
          "valueSize": 50
        },
        "textMode": "auto",
        "wideLayout": true
      },
      "pluginVersion": "12.2.1",
      "targets": [
        {
          "datasource": {
            "type": "prometheus"
          },
          "editorMode": "code",
          "expr": "clamp_min(\n  max_over_time(sum(gpu_nodes_total{host=~\"$host\"})[$__range:])\n  - sum(\n    gpu_health{host=~\"$host\"} \n      * on(host, gpu_id) group_left(pcie_port)\n        gpu_pcie_port{host=~\"$host\", pcie_port=~\"$pcie_port\"}\n  )\n  , 0\n)",
          "format": "time_series",
          "hide": false,
          "instant": false,
          "interval": "5s",
          "legendFormat": "",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "# GPU Errors",
      "type": "stat"
    },
